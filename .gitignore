# Dependencies
node_modules/
vendor/

# Environment
.env
.env.*
!.env.example

# Build output
dist/
build/

# ...except the deploy artefact. SiteGround shared hosting has no Node, so the
# Angular bundle cannot be built on the server — it is built locally and
# committed here, and the subdomain's document root points at it. Generated by
# `npm run deploy` in web/; never edit it by hand.
!deploy/
!deploy/**
/web/.angular/
/api/public/build/
/api/public/hot/
/api/public/storage/
/api/storage/*.key
/api/storage/pail/

# Laravel runtime
/api/bootstrap/cache/*.php
/api/storage/framework/cache/data/*
/api/storage/framework/sessions/*
/api/storage/framework/testing/*
/api/storage/framework/views/*
/api/storage/logs/*
!**/.gitignore

# Tooling caches
.phpunit.result.cache
.phpunit.cache/
*.tsbuildinfo

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-error.log*

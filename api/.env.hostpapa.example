# =============================================================================
# FreightMove API — HostPapa production
# =============================================================================
#
# Goes at:  /home/USER/api.freightmove.au/.env
#
# That is the APP root — one level ABOVE the document root, which is
# .../api.freightmove.au/public. If .env ever sits inside public/, it is a
# public URL containing your PayPal secret and database password.
#
# Copy this file's contents into File Manager, fill in the six <...> values,
# then run `php artisan config:cache` via a one-shot cron. A cached config
# ignores this file until you do — re-run it after EVERY edit.
#
# Do NOT upload your local api/.env. It points at 127.0.0.1 with APP_DEBUG on,
# which on a public host renders a stack-trace page containing these values.
# =============================================================================

APP_NAME=FreightMove
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.freightmove.au

# Reuse the APP_KEY from the SiteGround .env if you have it — existing browser
# sessions then survive the move. A fresh one (`php artisan key:generate --show`
# locally) is also fine: nothing in this database is encrypted at rest, so the
# only consequence is that signed-in users sign in again.
APP_KEY=<base64:... from SiteGround, or generate a new one>

# Every origin the browser may call this API from, comma separated.
# The FIRST entry is canonical: password-reset links and PayPal returns land
# there. `www` and the bare domain are DIFFERENT origins — list both or one of
# them gets a CORS error that leaves nothing in the API log.
# No trailing slashes.
FRONTEND_URL=https://www.freightmove.au,https://freightmove.au

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# `debug` on a live server fills the disk and writes request payloads to a file
# inside the account. `warning` keeps what you would actually act on.
LOG_LEVEL=warning

# -- Database ----------------------------------------------------------------
# From cPanel → MySQL® Databases. cPanel prefixes BOTH the database and the
# user with your account name, e.g. mycpanel_freightmove / mycpanel_fmuser.
# Host is `localhost` on cPanel, not 127.0.0.1.

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<USER_freightmove>
DB_USERNAME=<USER_fmuser>
DB_PASSWORD=<the password you set in cPanel>

# The same database, deliberately. The legacy tables were renamed
# (legacy_users, legacy_jobs, …) so both schemas live together — this is not a
# copy-paste mistake to fix.
LEGACY_DB_HOST=localhost
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=<USER_freightmove>
LEGACY_DB_USERNAME=<USER_fmuser>
LEGACY_DB_PASSWORD=<the password you set in cPanel>

# -- Framework storage -------------------------------------------------------
# `database` for all three: the migrations create these tables, and it avoids
# the file-permission problems shared hosting is prone to.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# -- Mail --------------------------------------------------------------------
# Resend is an HTTPS API, so the outbound SMTP port blocking common on shared
# hosting does not apply. Nothing to configure with the host.
#
# MAIL_FROM_ADDRESS stays on the verified sending subdomain — it is NOT the
# contact address. Replies are routed by Reply-To.

MAIL_MAILER=resend
RESEND_KEY=<same value as your local .env>
MAIL_FROM_ADDRESS="no-reply@send.freightmove.au"
MAIL_FROM_NAME="FreightMove"

FM_CONTACT_RECIPIENT=peter.freightmove@gmail.com
FM_PAYMENT_RECIPIENT=peter.freightmove@gmail.com
FM_LOAD_ALERT_ADMIN=peter.freightmove@gmail.com

# -- PayPal ------------------------------------------------------------------
# Identical to your local .env — these are already the live credentials.
# After the move, repoint the webhook in the PayPal dashboard to:
#   https://api.freightmove.au/api/v1/webhooks/paypal

FM_PAYMENT_GATEWAY=paypal
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=<same value as your local .env>
PAYPAL_CLIENT_SECRET=<same value as your local .env>
PAYPAL_WEBHOOK_ID=<same value as your local .env>

# -- Google Places -----------------------------------------------------------
# Served to the browser by GET /api/v1/public/config, never compiled into the
# bundle. This was left unset on SiteGround, which is why suburb autocomplete
# does not work today — setting it here fixes that.
#
# The key's HTTP-referrer restriction must list https://freightmove.au/* and
# https://www.freightmove.au/*, or it loads and then has every prediction
# rejected, which looks identical to a broken integration.

FM_GOOGLE_MAPS_KEY=<same value as your local .env>

# -- Cron --------------------------------------------------------------------
# Generate a NEW one for production; do not reuse the development token:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
#
# HostPapa has real cron, so the token-guarded URLs are a fallback rather than
# the mechanism. Keep it set anyway: unset, those URLs fail closed, which is
# what you want for a route that can mail every carrier.

FM_CRON_TOKEN=<64 hex characters, freshly generated>

# -- Load alerts -------------------------------------------------------------
# While FM_LOAD_ALERT_TEST_RECIPIENT has a value, every new-load alert goes to
# that ONE address instead of all 282 carriers. That is the safe setting for
# the first days on a new host.
#
# Blank it only when you are ready — the next load posted then mails everyone,
# from a server whose sending reputation is brand new.

FM_LOAD_ALERTS=true
FM_LOAD_ALERT_TEST_RECIPIENT=peter.freightmove@gmail.com

# -- Subscription reminders --------------------------------------------------
# Set this to the cutover date BEFORE the scheduler first runs. Without it the
# first sweep emails 76 carriers about subscriptions that lapsed as long ago as
# 2024 — measured, not guessed: `subscriptions:remind --dry-run` reports
# expired:76 with no cutoff and expired:0 with one.

FM_SUBSCRIPTION_REMINDER_IGNORE_BEFORE=<YYYY-MM-DD, the day you go live>

# -- Load board --------------------------------------------------------------
# The default of 7 days shows 1 of 102 loads, because the imported loads are
# older than a week. 0 disables the window entirely and shows every open load.

FM_BOARD_RECENCY_DAYS=0

# =============================================================================
# Deliberately NOT set
# =============================================================================
#
# SANCTUM_STATEFUL_DOMAINS — this API authenticates with bearer tokens, not
#   session cookies (config/cors.php has supports_credentials => false).
#   Adding it does nothing and invites cookie/CORS debugging that has no
#   bearing on the actual auth path.
#
# FM_MAIL_QUEUE — leave it off. Turned on without a `queue:work` cron, mail is
#   written to the jobs table and never sent: silently, with no error anywhere.
#
# FM_REQUIRE_SUBSCRIPTION_TO_QUOTE / FM_REQUIRE_SUBSCRIPTION_FOR_CONTACTS —
#   both default false, which is the current intent: carriers quote and see
#   shipper details for free. See docs/10-domain-rules.md R3.
#
# REDIS_* / MEMCACHED_HOST / AWS_* — nothing uses them on this host.

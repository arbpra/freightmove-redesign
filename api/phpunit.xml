<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- A separate database so running tests never touches development data.
             Kept on MySQL rather than SQLite so tests exercise the same JSON,
             DECIMAL and YEAR column behaviour as production. -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="freightmove_testing"/>
        <env name="MAIL_MAILER" value="array"/>
        <!-- Pinned so the suite does not depend on whoever's .env it runs
             beside. Without this, a developer or a server switching
             FM_PAYMENT_GATEWAY to paypal turns six SubscriptionTest cases red
             for a configuration reason that has nothing to do with the code
             under test. PayPalPaymentTest sets its own gateway per test. -->
        <env name="FM_PAYMENT_GATEWAY" value="manual"/>
        <!-- Same reasoning as the gateway above: a developer or a server
             with a test recipient set would otherwise divert every fan-out in
             the suite to one address, turning five passing tests red for a
             configuration reason unrelated to the code under test. Tests that
             care set it themselves. -->
        <env name="FM_LOAD_ALERTS" value="true"/>
        <env name="FM_LOAD_ALERT_TEST_RECIPIENT" value=""/>
        <!-- Third key to need pinning for the same reason. Any env var that
             changes behaviour must be declared here, or the suite's result
             depends on whoever's .env it happens to run beside — and a
             developer protecting their own machine from mailing real
             customers should not turn four unrelated tests red. -->
        <env name="FM_SUBSCRIPTION_REMINDER_IGNORE_BEFORE" value=""/>
        <env name="FM_SUBSCRIPTION_REMINDER_DAYS" value="5,3,1"/>
        <env name="FM_SUBSCRIPTION_REMINDER_AFTER_DAYS" value="3,7,15"/>
        <env name="FM_SUBSCRIPTION_REMINDER_MONTHS" value="0"/>
        <!-- The two entitlement gates. Both ship off, and the tests that
             prove the enforced behaviour switch them on themselves via
             config(). Pinned so that turning either on in a .env — which is
             a supported production choice — cannot quietly rewrite what the
             suite is asserting. -->
        <env name="FM_REQUIRE_SUBSCRIPTION_TO_QUOTE" value="false"/>
        <env name="FM_REQUIRE_SUBSCRIPTION_FOR_CONTACTS" value="false"/>
        <env name="FM_CRON_TOKEN" value=""/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>

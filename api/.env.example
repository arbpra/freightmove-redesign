APP_NAME=FreightMove
APP_ENV=local
APP_KEY=
# MUST be false in production: with it on, exception messages (file paths,
# SQL) are returned in the API envelope and shown to the user.
APP_DEBUG=true
APP_URL=http://localhost:8000

# The only origin allowed through CORS. Set to the real site in production.
FRONTEND_URL=http://localhost:4200

# Access token lifetime in minutes. Tokens live in browser localStorage,
# so this bounds how long a stolen one stays replayable.
SANCTUM_TOKEN_MINUTES=720

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=freightmove
DB_USERNAME=root
DB_PASSWORD=

# Restored dump of the pre-launch database, read by `php artisan legacy:import`.
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=old_freightmove
LEGACY_DB_USERNAME=root
LEGACY_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Where the Angular app is served. Used for CORS and for the links in emails
# people are meant to click, such as password reset.
FRONTEND_URL=http://localhost:4200

# Where website contact enquiries are emailed. Falls back to MAIL_FROM_ADDRESS.
# Every enquiry is stored in `contact_messages` regardless.
FM_CONTACT_RECIPIENT=

# Where a "payment received" copy goes when a carrier pays. Comma-separated for
# more than one person. Falls back to FM_CONTACT_RECIPIENT.
#
# Under the PayPal gateway nobody here touches the transaction — the carrier
# pays, the capture confirms and the subscription switches itself on — so this
# is the only notice that money arrived.
FM_PAYMENT_RECIPIENT=

# Send transactional email through the queue instead of during the request.
# Only turn this on where a queue worker actually runs — otherwise mail is
# written to the queue and never sent, which is worse than a slow request.
FM_MAIL_QUEUE=false

# Load photos. Shown publicly on the board, so SVG is not accepted — see
# config/freightmove.php. Needs `php artisan storage:link` once per environment.
FM_LOAD_MAX_IMAGES=6
FM_LOAD_MAX_IMAGE_KB=6144

# --- Load alerts ------------------------------------------------------------
# Emailing carriers when a shipper posts a load. OFF by default: there are ~295
# active carriers and ~40 loads a month, so switching this on is ~11,800
# messages a month to an audience that has never had any. The domain that
# carries these also carries password resets, and complaints are scored against
# all of it together. Preview with `php artisan loads:alert --dry-run`.
FM_LOAD_ALERTS=false

# all | subscribed | verified.  `all` is every active carrier (295 today);
# `subscribed` is only those with a current subscription (6 today), which makes
# the alert part of what the subscription buys.
FM_LOAD_ALERT_AUDIENCE=all

# Send the carrier alert to ONE address instead of the audience. Set on
# staging, BLANK ON LIVE. With an address here carriers get nothing and you
# receive the message they would have had.
FM_LOAD_ALERT_TEST_RECIPIENT=

# Where the operator's "new load posted" copy goes. Falls back to
# FM_CONTACT_RECIPIENT.
FM_LOAD_ALERT_ADMIN=

# Marketplace behaviour — see config/freightmove.php for the reasoning behind
# each default, and docs/10-domain-rules.md for the legacy behaviour they mirror.

# How many days back the carrier load board reaches. Legacy hardcoded 7.
# 0 shows every open load.
FM_BOARD_RECENCY_DAYS=7

# Minimum hours between bumps of the same load. Legacy had no limit, which let
# one shipper hold the top of the board indefinitely. 0 restores that.
FM_RELIST_COOLDOWN_HOURS=24

# Whether an active subscription is required to quote. The subscription is the
# paid product, so this should end up true — but only 2 of 291 migrated carriers
# hold a current one, so turning it on today locks out 289. Read the note in
# config/freightmove.php before changing it.
FM_REQUIRE_SUBSCRIPTION_TO_QUOTE=false

# While the above is on, carriers migrated from the old site can still quote
# until this date (Y-m-d). Blank disables grandfathering.
FM_LEGACY_QUOTING_GRACE_UNTIL=

# Whether an active subscription is required to see who posted a load — the
# shipper's name, phone and email. Independent of the quoting gate above.
# Off means every signed-in carrier sees them; a guest never does either way.
# This is the disintermediation guard, so it is the thing to turn on first when
# the subscription starts being enforced. Read the note in
# config/freightmove.php before changing it.
FM_REQUIRE_SUBSCRIPTION_FOR_CONTACTS=false

# Carrier verification. Uploads are capped and stored on the private disk.
FM_MAX_UPLOAD_KB=8192

# Whether a carrier must be verified before they can quote. The marketing site
# says "verified carriers only", so this should end up true — but the previous
# platform had no verification at all, so NONE of the 291 migrated carriers is
# verified and turning this on today would empty the marketplace.
FM_REQUIRE_VERIFICATION_TO_QUOTE=false

# Carrier subscriptions.
# Last date a carrier may START the free trial (Y-m-d). Blank = offer open.
# The live pricing page says 31-03-2026, which has passed, while the legacy data
# shows trials still being granted — so this defaults to open rather than
# silently locking anyone out.
FM_TRIAL_OFFER_ENDS=

# Subscription reminders — `php artisan subscriptions:remind`, run daily by the
# scheduler. Milestones, not exact match days: a carrier gets at most one email
# per milestone ever, and the copy quotes the real elapsed time, so a sweep that
# runs late still says something true. Blank disables that side.
FM_SUBSCRIPTION_REMINDER_DAYS=5,3,1
FM_SUBSCRIPTION_REMINDER_AFTER_DAYS=3,7,15

# Then one a month on the anniversary of the end date, for this many months.
# 0 = never stop, which is the default.
FM_SUBSCRIPTION_REMINDER_MONTHS=0

# Never remind about a period that ended before this date (Y-m-d). Blank = no
# cutoff. This matters on real data: 88 of the 90 migrated subscription periods
# are already expired, some since 2024, so with an open-ended monthly cadence
# every one of those carriers is in scope the first time this runs. Set it to
# roughly today's date before the first live run.
FM_SUBSCRIPTION_REMINDER_IGNORE_BEFORE=

# How carriers pay: `manual` (an admin confirms the money arrived) or `paypal`.
# Stays on `manual` until the PayPal credentials below are filled in — an
# unconfigured gateway would fail every checkout.
# `paypal` redirects the carrier to PayPal and switches the subscription on as
# soon as the capture confirms — no admin step. `manual` reserves the plan and
# waits for an admin to confirm the money arrived, which is what runs with no
# credentials configured.
FM_PAYMENT_GATEWAY=manual

# PayPal Checkout (Orders v2) — the same integration the previous site used,
# so the merchant account and AUD pricing already exist.
#   1. Create an app at developer.paypal.com and copy its client id/secret.
#   2. Set PAYPAL_MODE=live only once you have tested in sandbox.
#   3. Register a webhook at <API_URL>/api/v1/webhooks/paypal subscribed to
#      CHECKOUT.ORDER.APPROVED, PAYMENT.CAPTURE.COMPLETED, .DENIED, .REFUNDED
#      and paste its id below. Without PAYPAL_WEBHOOK_ID webhooks cannot be
#      verified and are refused — deliberately, since an unverified webhook
#      endpoint hands out subscriptions to anyone who can POST to it.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

# Shown to a carrier who reserves a paid plan under the manual gateway.
# Deliberately blank: invented bank details could cost somebody real money.
FM_PAYMENT_INSTRUCTIONS=

# Google Places key for the address autocomplete on the post-a-load form.
# Served to the browser by GET /api/v1/public/config rather than compiled into
# the Angular bundle, because that bundle is committed to the repository.
# It is public once served; restrict it by HTTP referrer and to the Places API
# only. See docs/11-security.md section 5a. Blank = plain text inputs.
FM_GOOGLE_MAPS_KEY=

# --- Resend (outbound email) ------------------------------------------------
# The transport this application uses. Set MAIL_MAILER=resend once the key is
# in place; `log` writes the email to storage/logs and sends nothing, which is
# the right default for local work.
#
#   1. Add and verify your sending domain at resend.com/domains
#      (publish the SPF and DKIM records it gives you)
#   2. Create a key at resend.com/api-keys  ->  starts `re_`
#   3. MAIL_FROM_ADDRESS must be on the verified domain, or sends are refused
#
# One key, no domain or region settings to get wrong.
RESEND_KEY=

# --- Scheduled work over HTTP -----------------------------------------------
# SiteGround's SSH has no `crontab`, so the sweeps can also be triggered by
# fetching a URL. This token is the only thing standing between those URLs and
# anyone who guesses them — the previous site shipped the same idea as a public
# route that would mail the entire user base on demand.
#
# Generate one with:  php artisan cron:token
# Blank means the cron routes refuse everything, which is the safe default.
FM_CRON_TOKEN=

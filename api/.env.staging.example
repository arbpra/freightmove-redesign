# FreightMove API — staging on SiteGround (api.freightmove.au)
#
# Copy to `.env` on the server and fill in the blanks. Never commit the real
# file; it holds database and payment credentials.
#
# Generate the key on the server with:  php artisan key:generate

APP_NAME=FreightMove
APP_ENV=staging

# MUST stay false. With debug on, Laravel returns exception messages in the API
# envelope and the Angular client displays them — file paths and SQL on screen.
APP_DEBUG=false

APP_KEY=
APP_URL=https://api.freightmove.au

APP_TIMEZONE=Australia/Sydney
APP_LOCALE=en

# Origins allowed to call this API, comma separated. The FIRST one is where
# password-reset emails and PayPal returns send people, so keep the site you
# are actually testing at the front.
FRONTEND_URL=https://new.freightmove.au

LOG_CHANNEL=stack
LOG_LEVEL=warning

# --- Database ---------------------------------------------------------------
# SiteGround: Site Tools > MySQL > Databases. The user needs full privileges on
# this database. Host stays localhost on shared hosting.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# The legacy database, for `php artisan legacy:import`. Create it as a second
# database and import the freightmove.au backup into it. Leave blank until you
# are ready to migrate — nothing else in the app touches this connection.
LEGACY_DB_HOST=localhost
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=

# --- Sessions, cache, queue -------------------------------------------------
# Database-backed so nothing depends on Redis, which shared plans do not offer.
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Mail -------------------------------------------------------------------
# Nine transactional emails depend on this working — quote received, quote
# accepted, new message, verification decisions, load posted, subscription
# receipt, password reset and contact enquiries. See docs/06-api-spec.md.
#
# Set this to `resend` once RESEND_KEY is filled in at the bottom of this file.
# `log` is the safe default: the application works, the email is written to
# storage/logs, and nothing is sent.
MAIL_MAILER=log

# Must be on the domain verified at resend.com/domains, e.g.
# no-reply@freightmove.au. Resend refuses a send from anything else.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="FreightMove"

# Where contact form enquiries go. Falls back to MAIL_FROM_ADDRESS.
FM_CONTACT_RECIPIENT=

# Where a "payment received" copy goes when a carrier pays. Comma-separated for
# more than one person. Falls back to FM_CONTACT_RECIPIENT.
#
# Under the PayPal gateway nobody here touches the transaction — the carrier
# pays, the capture confirms and the subscription switches itself on — so this
# is the only notice that money arrived.
FM_PAYMENT_RECIPIENT=

# Send email through the queue rather than during the request. Leave FALSE
# until the cron in docs/12-deployment-siteground.md is set up — with no worker
# running, mail is queued and never sent.
FM_MAIL_QUEUE=false

# Load photos. Run `php artisan storage:link` once, or uploaded photos 404.
FM_LOAD_MAX_IMAGES=6
FM_LOAD_MAX_IMAGE_KB=6144

# --- Load alerts ------------------------------------------------------------
# Emailing carriers when a shipper posts a load. OFF by default: there are ~295
# active carriers and ~40 loads a month, so switching this on is ~11,800
# messages a month to an audience that has never had any. The domain that
# carries these also carries password resets, and complaints are scored against
# all of it together. Preview with `php artisan loads:alert --dry-run`.
FM_LOAD_ALERTS=false

# all | subscribed | verified.  `all` is every active carrier (295 today);
# `subscribed` is only those with a current subscription (6 today), which makes
# the alert part of what the subscription buys.
FM_LOAD_ALERT_AUDIENCE=all

# Send the carrier alert to ONE address instead of the audience. Set on
# staging, BLANK ON LIVE. With an address here carriers get nothing and you
# receive the message they would have had.
FM_LOAD_ALERT_TEST_RECIPIENT=

# Where the operator's "new load posted" copy goes. Falls back to
# FM_CONTACT_RECIPIENT.
FM_LOAD_ALERT_ADMIN=

# --- Marketplace behaviour --------------------------------------------------
# All three gates are OFF. Read docs/08-development-roadmap.md before changing
# any of them — each one locks out migrated carriers if switched on too early.

FM_BOARD_RECENCY_DAYS=7
FM_RELIST_COOLDOWN_HOURS=24

# 289 of 291 migrated carriers have no current subscription.
FM_REQUIRE_SUBSCRIPTION_TO_QUOTE=false

# NONE of the migrated carriers is verified — the old platform had no
# verification at all.
FM_REQUIRE_VERIFICATION_TO_QUOTE=false

FM_MAX_UPLOAD_KB=8192

# Blank = the free trial offer is open. See docs/08.
FM_TRIAL_OFFER_ENDS=

# Subscription reminders — `php artisan subscriptions:remind`, run daily by the
# scheduler. Milestones, not exact match days: a carrier gets at most one email
# per milestone ever, and the copy quotes the real elapsed time, so a sweep that
# runs late still says something true. Blank disables that side.
FM_SUBSCRIPTION_REMINDER_DAYS=5,3,1
FM_SUBSCRIPTION_REMINDER_AFTER_DAYS=3,7,15

# Then one a month on the anniversary of the end date, for this many months.
# 0 = never stop, which is the default.
FM_SUBSCRIPTION_REMINDER_MONTHS=0

# Never remind about a period that ended before this date (Y-m-d). Blank = no
# cutoff. This matters on real data: 88 of the 90 migrated subscription periods
# are already expired, some since 2024, so with an open-ended monthly cadence
# every one of those carriers is in scope the first time this runs. Set it to
# roughly today's date before the first live run.
FM_SUBSCRIPTION_REMINDER_IGNORE_BEFORE=

# --- Payments ---------------------------------------------------------------
# Leave as `manual` until the PayPal credentials below are filled in and tested
# in sandbox. On manual, an admin confirms payments from the admin queue.
FM_PAYMENT_GATEWAY=manual
FM_PAYMENT_INSTRUCTIONS=

# PayPal Checkout (Orders v2). Use SANDBOX credentials on staging — real ones
# would take real money from whoever tests it.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# From the webhook you register at
# https://api.freightmove.au/api/v1/webhooks/paypal
# Without it, webhooks cannot be verified and are refused.
PAYPAL_WEBHOOK_ID=

# Bcrypt cost. 12 is right for modern hardware; drop to 10 only if shared
# hosting CPU makes logins slow.
BCRYPT_ROUNDS=12

# Google Places key. Restrict it to https://new.freightmove.au/* before use.
# Blank = the address fields stay plain text inputs.
FM_GOOGLE_MAPS_KEY=

# --- Resend (outbound email) ------------------------------------------------
# Preferred over SMTP on shared hosting: SiteGround throttles outbound SMTP and
# blocks some ports, and a throttled handshake looks like a slow request rather
# than an error. Resend is an HTTP API, so none of that applies.
#
# Key from resend.com/api-keys (starts `re_`). The domain must be verified at
# resend.com/domains with its SPF and DKIM records published, and
# MAIL_FROM_ADDRESS must sit on that domain.
RESEND_KEY=

# --- Scheduled work over HTTP -----------------------------------------------
# SiteGround's SSH has no `crontab`, so the sweeps can also be triggered by
# fetching a URL. This token is the only thing standing between those URLs and
# anyone who guesses them — the previous site shipped the same idea as a public
# route that would mail the entire user base on demand.
#
# Generate one with:  php artisan cron:token
# Blank means the cron routes refuse everything, which is the safe default.
FM_CRON_TOKEN=

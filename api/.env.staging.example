# FreightMove API — staging on SiteGround (api.freightmove.au)
#
# Copy to `.env` on the server and fill in the blanks. Never commit the real
# file; it holds database and payment credentials.
#
# Generate the key on the server with:  php artisan key:generate

APP_NAME=FreightMove
APP_ENV=staging

# MUST stay false. With debug on, Laravel returns exception messages in the API
# envelope and the Angular client displays them — file paths and SQL on screen.
APP_DEBUG=false

APP_KEY=
APP_URL=https://api.freightmove.au

APP_TIMEZONE=Australia/Sydney
APP_LOCALE=en

# Origins allowed to call this API, comma separated. The FIRST one is where
# password-reset emails and PayPal returns send people, so keep the site you
# are actually testing at the front.
FRONTEND_URL=https://new.freightmove.au

LOG_CHANNEL=stack
LOG_LEVEL=warning

# --- Database ---------------------------------------------------------------
# SiteGround: Site Tools > MySQL > Databases. The user needs full privileges on
# this database. Host stays localhost on shared hosting.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# The legacy database, for `php artisan legacy:import`. Create it as a second
# database and import the freightmove.au backup into it. Leave blank until you
# are ready to migrate — nothing else in the app touches this connection.
LEGACY_DB_HOST=localhost
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=

# --- Sessions, cache, queue -------------------------------------------------
# Database-backed so nothing depends on Redis, which shared plans do not offer.
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Mail -------------------------------------------------------------------
# SiteGround: Site Tools > Email > Accounts, then use those SMTP details.
# Password reset and contact enquiries both depend on this working.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="FreightMove"

# Where contact form enquiries go. Falls back to MAIL_FROM_ADDRESS.
FM_CONTACT_RECIPIENT=

# --- Marketplace behaviour --------------------------------------------------
# All three gates are OFF. Read docs/08-development-roadmap.md before changing
# any of them — each one locks out migrated carriers if switched on too early.

FM_BOARD_RECENCY_DAYS=7
FM_RELIST_COOLDOWN_HOURS=24

# 289 of 291 migrated carriers have no current subscription.
FM_REQUIRE_SUBSCRIPTION_TO_QUOTE=false

# NONE of the migrated carriers is verified — the old platform had no
# verification at all.
FM_REQUIRE_VERIFICATION_TO_QUOTE=false

FM_MAX_UPLOAD_KB=8192

# Blank = the free trial offer is open. See docs/08.
FM_TRIAL_OFFER_ENDS=

# --- Payments ---------------------------------------------------------------
# Leave as `manual` until the PayPal credentials below are filled in and tested
# in sandbox. On manual, an admin confirms payments from the admin queue.
FM_PAYMENT_GATEWAY=manual
FM_PAYMENT_INSTRUCTIONS=

# PayPal Checkout (Orders v2). Use SANDBOX credentials on staging — real ones
# would take real money from whoever tests it.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# From the webhook you register at
# https://api.freightmove.au/api/v1/webhooks/paypal
# Without it, webhooks cannot be verified and are refused.
PAYPAL_WEBHOOK_ID=

# Bcrypt cost. 12 is right for modern hardware; drop to 10 only if shared
# hosting CPU makes logins slow.
BCRYPT_ROUNDS=12
